DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Required — no default. The admin dashboard stays locked until this is set.
# Use a long random string (e.g. `openssl rand -hex 24`), NOT a memorable phrase.
ADMIN_PASSWORD=""
# Recommended — peppers the session cookie so it is not derivable from the
# admin password alone. Falls back to ADMIN_PASSWORD if unset.
SESSION_SECRET=""
# Set to "false" ONLY for plain-HTTP deployments (e.g. bare-IP server before
# SSL): browsers refuse Secure cookies over HTTP, which locks out /admin.
# Defaults to true in production.
COOKIE_SECURE=""
LEAD_WEBHOOK_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
