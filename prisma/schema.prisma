generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  company    String?
  productKey String?
  productName String?
  offerType  String
  budget     String?
  message    String
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}
